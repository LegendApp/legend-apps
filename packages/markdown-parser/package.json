{
  "name": "@legend-desktop/markdown-parser",
  "version": "0.0.0",
  "private": true,
  "main": "src/index.ts",
  "react-native": "src/index.ts",
  "codegenConfig": {
    "name": "RNMarkdownParserSpec",
