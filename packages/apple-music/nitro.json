{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["legendapps", "applemusic"],
  "ios": {
    "iosModuleName": "RNAppleMusic"
  },
  "android": {
    "androidNamespace": ["legendapps", "applemusic"],
    "androidCxxLibName": "RNAppleMusic"
  },
  "autolinking": {
    "AppleMusic": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridAppleMusic"
      }
    }
  },
  "ignorePaths": ["**/node_modules"],
  "gitAttributesGeneratedFlag": true
}
