    },
    "fallback": {
      "marginBottom": 19.2,
      "marginTop": 19.2
    },
    "heading": {
      "1": {
        "marginBottom": 24,
        "marginTop": 48
      },
      "2": {
        "marginBottom": 19.2,
        "marginTop": 40
      },
      "3": {
        "marginBottom": 16,
        "marginTop": 32
      },
      "4": {
        "marginBottom": 12.8,
        "marginTop": 28
      },
      "5": {
        "marginBottom": 9.6,
        "marginTop": 24
      },
      "6": {
        "marginBottom": 9.6,
        "marginTop": 24
      }
    },
    "list": {
      "marginBottom": 19.2,
      "marginTop": 19.2
    },
    "paragraph": {
      "marginBottom": 19.2,
      "marginTop": 19.2
    },
    "table": {
