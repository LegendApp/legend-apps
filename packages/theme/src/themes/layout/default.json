    "thematicBreak": {
      "marginBottom": 48,
      "marginTop": 48
    }
  },
  "blocks": {
    "blockquoteBorderWidth": 3,
    "codeBlockBorderRadius": 6,
    "codeBlockBorderWidth": 1,
    "codeBlockPadding": 20,
    "listGapWidth": 8,
    "tableBorderRadius": 6,
    "tableBorderWidth": 1,
