      "2": 1.5,
      "3": 1.25,
      "4": 1.125,
      "5": 1,
      "6": 0.9375
    },
    "headingWeight": "700",
    "lineHeightScale": 1.58,
    "tableFontSizeOffset": -2
  },
  "spacing": {
    "blockquote": {
      "marginBottom": 24,
      "marginTop": 24
    },
    "codeBlock": {
      "marginBottom": 51.2,
