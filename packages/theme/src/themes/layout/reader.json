    "fallback": {
      "marginBottom": 24,
      "marginTop": 24
    },
    "heading": {
      "1": {
        "marginBottom": 28,
        "marginTop": 60
      },
      "2": {
        "marginBottom": 22,
        "marginTop": 48
      },
      "3": {
        "marginBottom": 18,
        "marginTop": 38
      },
      "4": {
        "marginBottom": 14,
        "marginTop": 32
      },
      "5": {
        "marginBottom": 12,
        "marginTop": 28
      },
      "6": {
        "marginBottom": 12,
        "marginTop": 28
      }
    },
    "list": {
      "marginBottom": 24,
      "marginTop": 24
    },
    "paragraph": {
      "marginBottom": 24,
      "marginTop": 24
    },
    "table": {
      "marginBottom": 30,
      "marginTop": 30
    },
    "thematicBreak": {
