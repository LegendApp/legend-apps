    "codeFontSizeOffset": -3,
    "headingLineHeightScale": 1.35,
    "headingScale": {
      "1": 2,
      "2": 1.58,
      "3": 1.32,
      "4": 1.16,
      "5": 1,
      "6": 0.94
    },
    "headingWeight": "700",
    "lineHeightScale": 1.72,
    "tableFontSizeOffset": -2
  },
  "spacing": {
    "blockquote": {
