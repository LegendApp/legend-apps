    "codeBlockBorderRadius": 7,
    "codeBlockBorderWidth": 1,
    "codeBlockPadding": 22,
    "listGapWidth": 9,
    "tableBorderRadius": 6,
    "tableBorderWidth": 1,
    "tableCellPaddingHorizontal": 9,
    "tableCellPaddingVertical": 7
