+double RNSkAppleVideo::syncHostTime() {
+  return CMTimeGetSeconds(CMClockGetTime(CMClockGetHostTimeClock())) * 1000;
+}
+
+void RNSkAppleVideo::prepareSync(double timestamp) {
+  prepareSynchronizedFrame(timestamp, 0);
+}
+
+void RNSkAppleVideo::prepareSynchronizedFrame(double timestamp,
+                                             uint64_t endingGeneration) {
+  auto state = _sync;
+  double target = std::max(0.0, std::min(timestamp, _duration - 1.0));
+  uint64_t generation;
+  {
+    std::lock_guard<std::mutex> lock(state->mutex);
+    if (endingGeneration && endingGeneration != state->generation) return;
+    generation = ++state->generation;
+    state->enabled = true;
+    state->ready = false;
+    state->seekComplete = false;
+    state->failed = false;
+    state->ended = endingGeneration != 0;
+  }
+  auto lifetime = _displayLinkState;
+  dispatch_async(dispatch_get_main_queue(), ^{
+    std::lock_guard<std::mutex> alive(lifetime->mutex);
+    auto *video = lifetime->video;
+    if (!video) return;
+    {
+      std::lock_guard<std::mutex> lock(state->mutex);
+      if (generation != state->generation) return;
+    }
+    [video->_player pause];
+    video->_isPlaying = false;
+    video->_isLooping = false;
+    video->_player.muted = YES;
+    video->_player.automaticallyWaitsToMinimizeStalling = NO;
+    CMTime time = CMTimeMakeWithSeconds(target / 1000.0, NSEC_PER_SEC);
+    [video->_player seekToTime:time toleranceBefore:kCMTimeZero
+               toleranceAfter:kCMTimeZero completionHandler:^(BOOL finished) {
+      dispatch_async(dispatch_get_main_queue(), ^{
+        std::lock_guard<std::mutex> alive(lifetime->mutex);
+        auto *video = lifetime->video;
+        if (!video) return;
+        {
+          std::lock_guard<std::mutex> lock(state->mutex);
+          if (generation != state->generation) return;
+          state->failed = !finished || video->_player.status == AVPlayerStatusFailed;
+          state->seekComplete = !state->failed;
+        }
+        // Extract even when the completed seek targets the existing position.
+        video->expectFrame();
+      });
+    }];
+  });
+}
+
+void RNSkAppleVideo::playSync(double timestamp, double hostTime) {
+  auto state = _sync;
+  uint64_t generation;
+  {
+    std::lock_guard<std::mutex> lock(state->mutex);
+    generation = state->generation;
+  }
+  auto lifetime = _displayLinkState;
+  dispatch_async(dispatch_get_main_queue(), ^{
+    std::lock_guard<std::mutex> alive(lifetime->mutex);
+    auto *video = lifetime->video;
+    if (!video) return;
+    std::lock_guard<std::mutex> lock(state->mutex);
+    if (generation != state->generation || !state->ready) return;
+    [video->_player setRate:1.0
+                      time:CMTimeMakeWithSeconds(timestamp / 1000.0, NSEC_PER_SEC)
+                atHostTime:CMTimeMakeWithSeconds(hostTime / 1000.0, NSEC_PER_SEC)];
+    video->_isPlaying = true;
+    video->startDisplayLink();
+  });
+}
+#endif
+
 } // namespace RNSkia
