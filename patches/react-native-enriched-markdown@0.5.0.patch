+  NSPoint targetPoint = NSMakePoint(textContainerX, NSMidY(lineRect));
+  CGFloat fraction = 0;
+  NSUInteger glyphIndex = [layoutManager glyphIndexForPoint:targetPoint inTextContainer:textContainer fractionOfDistanceThroughGlyph:&fraction];
+  glyphIndex = MIN(MAX(glyphIndex, lineRange.location), NSMaxRange(lineRange) - 1);
+
+  NSUInteger characterIndex = [layoutManager characterIndexForGlyphAtIndex:glyphIndex];
