+    }
+    [self enrmStopSelectionDragPolling];
+    return;
+  }
+
+  [self enrmHandleSelectionDragAtWindowPoint:self.window.mouseLocationOutsideOfEventStream];
+}
+
+- (void)enrmHandleSelectionDragAtWindowPoint:(NSPoint)windowPoint
+{
+  self.enrmLastSelectionDragWindowPoint = windowPoint;
+  if (self.markdownTextInput == nil || self.selectedRange.length == 0) {
+    return;
+  }
+
+  NSRect boundsInWindow = [self convertRect:self.bounds toView:nil];
+  CGFloat pointerY = windowPoint.y;
+  CGFloat windowX = windowPoint.x;
+  CGFloat windowY = [self enrmTopOriginWindowYForWindowPoint:windowPoint];
+  if (pointerY < NSMinY(boundsInWindow)) {
+    self.enrmSelectionDragOutsideEmitted = YES;
