+template <typename BlockStyleProps>
+BOOL applyInputBlockStyleProps(ENRMInputFormatterStyle *style, const BlockStyleProps &blockStyle)
+{
+  BOOL changed = NO;
+
+  CGFloat fontSize = blockStyle.fontSize > 0 ? blockStyle.fontSize : style.baseFont.pointSize;
+  UIFont *font = nil;
+  if (blockStyle.fontWeight.empty()) {
+    font = [UIFont systemFontOfSize:fontSize];
+  } else {
+    NSString *weightString = [NSString stringWithUTF8String:blockStyle.fontWeight.c_str()];
+    UIFontWeight weight = ENRMFontWeightFromString(weightString);
+    font = [UIFont systemFontOfSize:fontSize weight:weight];
+  }
+
+  if (!blockStyle.fontFamily.empty()) {
+    NSString *familyName = [NSString stringWithUTF8String:blockStyle.fontFamily.c_str()];
+    UIFont *customFont = [UIFont fontWithName:familyName size:fontSize];
+    if (customFont) {
+      font = customFont;
+    }
+  }
+
+  if (![style.baseFont isEqual:font]) {
+    style.baseFont = font;
+    changed = YES;
+  }
+
+  if (isColorMeaningful(blockStyle.color)) {
+    RCTUIColor *color = RCTUIColorFromSharedColor(blockStyle.color);
+    if (![style.baseTextColor isEqual:color]) {
+      style.baseTextColor = color;
+      changed = YES;
+    }
+  }
+
+  CGFloat lineHeight = blockStyle.lineHeight > 0 ? blockStyle.lineHeight : 0;
+  if (style.baseLineHeight != lineHeight) {
+    style.baseLineHeight = lineHeight;
+    changed = YES;
+  }
+
+  return changed;
+}
