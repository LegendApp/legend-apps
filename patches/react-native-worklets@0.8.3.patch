+#if TARGET_OS_OSX
+// RCTPlatformDisplayLink queues a main run loop tick for every display pulse, so ticks queued while the
+// main thread is busy run back to back. This link keeps at most one tick queued or running, and an
+// invalidated link never restarts or delivers a queued tick.
+@interface WorkletsFrameLink : RCTPlatformDisplayLink
+@end
+
+@implementation WorkletsFrameLink {
+  CVDisplayLinkRef link_;
+  __weak id target_;
+  SEL selector_;
+  NSRunLoop *runLoop_;
+  NSRunLoopMode mode_;
+  // Orders Start/Stop with invalidation. The display link callback never takes it.
+  std::mutex controlMutex_;
+  std::atomic<bool> tickPending_;
+  std::atomic<bool> invalidated_;
+}
+
++ (instancetype)displayLinkWithTarget:(id)target selector:(SEL)selector
+{
+  WorkletsFrameLink *link = [self new];
+  link->target_ = target;
+  link->selector_ = selector;
+  return link;
+}
+
+static CVReturn WorkletsFrameLinkCallback(
+    CVDisplayLinkRef,
+    const CVTimeStamp *,
+    const CVTimeStamp *,
+    CVOptionFlags,
+    CVOptionFlags *,
+    void *context)
+{
+  WorkletsFrameLink *link = (__bridge WorkletsFrameLink *)context;
+  if (link->invalidated_ || link->tickPending_.exchange(true)) {
+    return kCVReturnSuccess;
+  }
+  CFRunLoopRef runLoop = link->runLoop_.getCFRunLoop;
+  CFRunLoopPerformBlock(runLoop, (__bridge CFTypeRef)link->mode_, ^{
+    @autoreleasepool {
+      id target = link->target_;
+      if (!link->invalidated_ && target) {
+        ((void (*)(id, SEL, WorkletsFrameLink *))[target methodForSelector:link->selector_])(
+            target, link->selector_, link);
+      }
+      link->tickPending_ = false;
+    }
+  });
+  CFRunLoopWakeUp(runLoop);
+  return kCVReturnSuccess;
+}
+
+- (void)dealloc
+{
+  if (link_ != NULL) {
+    CVDisplayLinkStop(link_);
+    CVDisplayLinkRelease(link_);
+  }
+}
+
+- (void)addToRunLoop:(NSRunLoop *)runLoop forMode:(NSRunLoopMode)mode
+{
+  runLoop_ = runLoop;
+  mode_ = mode;
+  if (CVDisplayLinkCreateWithActiveCGDisplays(&link_) != kCVReturnSuccess) {
+    CVDisplayLinkCreateWithCGDisplay(CGMainDisplayID(), &link_);
+  }
+  RCTAssert(link_ != NULL, @"Cannot create display link");
+  CVDisplayLinkSetOutputCallback(link_, &WorkletsFrameLinkCallback, (__bridge void *)self);
+}
+
+- (void)setPaused:(BOOL)paused
+{
+  std::lock_guard<std::mutex> lock(controlMutex_);
+  if (link_ == NULL || invalidated_) {
+    return;
+  }
+  if (paused) {
+    CVDisplayLinkStop(link_);
+  } else {
+    CVDisplayLinkStart(link_);
+  }
+}
+
+- (void)invalidate
+{
+  std::lock_guard<std::mutex> lock(controlMutex_);
+  invalidated_ = true;
+  if (link_ != NULL) {
+    CVDisplayLinkStop(link_);
+  }
+}
+
+- (BOOL)isPaused
+{
+  return link_ == NULL || !CVDisplayLinkIsRunning(link_);
+}
+
+- (NSTimeInterval)timestamp
+{
+  CVTimeStamp now = {};
+  CVDisplayLinkGetCurrentTime(link_, &now);
+  return (NSTimeInterval)now.hostTime / (NSTimeInterval)CVGetHostClockFrequency();
+}
+
+- (NSTimeInterval)duration
+{
+  const CVTime period = CVDisplayLinkGetNominalOutputVideoRefreshPeriod(link_);
+  return (period.flags & kCVTimeIsIndefinite) ? 0 : (NSTimeInterval)period.timeValue / period.timeScale;
+}
+
+@end
+#else // TARGET_OS_OSX
+typedef WorkletsDisplayLink WorkletsFrameLink;
+#endif // TARGET_OS_OSX
+
 @implementation AnimationFrameQueue {
   /* DisplayLink is thread safe. */
   WorkletsDisplayLink *displayLink_;
