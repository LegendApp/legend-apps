+    NSTextCheckingResult *headingMatch = [headingRegex firstMatchInString:trimmedMarkdown
+                                                                  options:0
+                                                                    range:NSMakeRange(0, trimmedMarkdown.length)];
+    if (headingMatch != nil) {
+      NSUInteger headingLevel = headingMatch.range.length - 1;
+      switch (headingLevel) {
+        case 1:
+          changed = applyInputBlockStyleProps(style, markdownStyle.h1);
+          break;
+        case 2:
+          changed = applyInputBlockStyleProps(style, markdownStyle.h2);
+          break;
+        case 3:
+          changed = applyInputBlockStyleProps(style, markdownStyle.h3);
+          break;
+        case 4:
+          changed = applyInputBlockStyleProps(style, markdownStyle.h4);
+          break;
+        case 5:
+          changed = applyInputBlockStyleProps(style, markdownStyle.h5);
+          break;
+        default:
+          changed = applyInputBlockStyleProps(style, markdownStyle.h6);
+          break;
+      }
+    } else {
+      changed = applyInputBlockStyleProps(style, markdownStyle.paragraph);
+    }
