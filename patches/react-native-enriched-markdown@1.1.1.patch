+
+NSString *ENRMMarkdownForNativeBlockId(NSString *blockId)
+{
+  if (blockId.length > 0) {
+    for (ENRMNativeMarkdownProvider provider in [nativeMarkdownProviders reverseObjectEnumerator]) {
+      NSString *markdown = provider(blockId);
+      if (markdown.length > 0) {
+        return markdown;
+      }
+    }
+  }
+  return @"";
+}
