+#pragma once
+#import <TargetConditionals.h>
+#if TARGET_OS_OSX
+#import <AppKit/AppKit.h>
+
+// Unwrapped code is laid out one line at a time. AppKit's whole-string drawing
+// path repeatedly shapes the remaining text for every newline in a tall block.
+@interface ENRMCodeBlockLineLayout : NSObject
+@property (nonatomic, readonly) CGSize size;
+- (instancetype)initWithAttributedCode:(NSAttributedString *)code;
++ (CGFloat)heightForAttributedCode:(NSAttributedString *)code;
