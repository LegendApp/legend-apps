+#import "ENRMBlockRange.h"
+#import "ParagraphStyleUtils.h"
+
+static inline NSDictionary *ENRMInputBaseTypingAttributes(ENRMInputFormatterStyle *style)
+{
+  NSMutableDictionary *attrs = [@{ NSFontAttributeName: style.baseFont,
+                                  NSForegroundColorAttributeName: style.baseTextColor } mutableCopy];
+  if (style.baseLineHeight > 0) {
+    NSMutableParagraphStyle *paragraph = [[NSMutableParagraphStyle alloc] init];
+    paragraph.minimumLineHeight = style.baseLineHeight;
+    paragraph.maximumLineHeight = style.baseLineHeight;
+    attrs[NSParagraphStyleAttributeName] = paragraph;
+  }
+  return attrs;
+}
+
+static inline void ENRMApplyInputParagraphBaselineOffset(NSTextStorage *storage, BOOL usesParagraphBaselineOffset)
+{
+  if (!usesParagraphBaselineOffset || storage.length == 0) {
+    return;
+  }
+  [storage enumerateAttribute:ENRMBlockTypeAttributeName inRange:NSMakeRange(0, storage.length) options:0
+                   usingBlock:^(NSNumber *type, NSRange range, BOOL *stop) {
+    if (type == nil || type.integerValue <= ENRMInputBlockTypeOrderedListItem) {
+      applyBaselineOffset(storage, range);
+    }
+  }];
+}
