@@ -0,0 +1,53 @@
+#pragma once
+
+#include <TargetConditionals.h>
+#if TARGET_OS_OSX
+#import <AppKit/AppKit.h>
+#else
+#import <UIKit/UIKit.h>
+#endif
+
+static inline NSMutableAttributedString *ENRMInputTextForMeasurement(NSAttributedString *text, NSDictionary *typingAttributes)
+{
+  NSMutableAttributedString *snapshot = [[NSMutableAttributedString alloc] initWithAttributedString:text];
+  if (snapshot.length == 0 || [[NSCharacterSet newlineCharacterSet]
+      characterIsMember:[snapshot.string characterAtIndex:snapshot.length - 1]]) {
+    [snapshot appendAttributedString:[[NSAttributedString alloc] initWithString:@"I" attributes:typingAttributes]];
+  }
+  return snapshot;
+}
+
+static inline NSAttributedString *ENRMPrepareInputMeasurementText(NSAttributedString *text, NSDictionary *typingAttributes)
+{
+  NSMutableAttributedString *snapshot = ENRMInputTextForMeasurement(text, typingAttributes);
+  NSMutableAttributedString *frozen = [[NSMutableAttributedString alloc] initWithString:snapshot.string];
+  // Attribute dictionaries are interned; distinguish snapshots from live mutable paragraph styles.
+  NSObject *identity = [[NSObject alloc] init];
+  [snapshot enumerateAttributesInRange:NSMakeRange(0, snapshot.length) options:0
+                           usingBlock:^(NSDictionary *attributes, NSRange range, BOOL *stop) {
+    NSMutableDictionary *copied = [attributes mutableCopy];
+    copied[@"ENRMInputMeasurementSnapshot"] = identity;
+    NSParagraphStyle *paragraph = attributes[NSParagraphStyleAttributeName];
+    if (paragraph) copied[NSParagraphStyleAttributeName] = [paragraph copy];
+    [frozen setAttributes:copied range:range];
+  }];
+  return [frozen copy];
+}
+
+#if TARGET_OS_OSX
+
+// NSString drawing subtracts baseline offsets from wrapped line heights.
+// Measure with the same TextKit layout and zero padding as the editing view.
+static inline CGFloat ENRMInputTextHeight(NSAttributedString *text, CGFloat width)
+{
+  NSTextStorage *storage = [[NSTextStorage alloc] initWithAttributedString:text];
+  NSLayoutManager *layout = [[NSLayoutManager alloc] init];
+  layout.backgroundLayoutEnabled = NO;
+  NSTextContainer *container = [[NSTextContainer alloc] initWithContainerSize:NSMakeSize(MAX(0, width), CGFLOAT_MAX)];
+  container.lineFragmentPadding = 0;
+  [layout addTextContainer:container];
+  [storage addLayoutManager:layout];
+  [layout ensureLayoutForTextContainer:container];
+  return ceil(NSMaxY([layout usedRectForTextContainer:container]));
+}
+#endif
diff --git a/ios/utils/ENRMInputScrolling.h b/ios/utils/ENRMInputScrolling.h
new file mode 100755
index 0000000..9a7e313
--- /dev/null
+++ b/ios/utils/ENRMInputScrolling.h
@@ -0,0 +1,22 @@
+#pragma once
+
+#include <TargetConditionals.h>
+#if TARGET_OS_OSX
+#import <AppKit/AppKit.h>
+
+static inline void ENRMConfigureInputScrolling(NSView *container, NSScrollView *scroll, NSTextView *text, BOOL enabled)
+{
+  // Fabric owns inline editor geometry. TextKit resizing would move its top
+  // edge in the unflipped host and invalidate AppKit's display cycle.
+  text.verticallyResizable = enabled;
+  text.horizontallyResizable = NO;
+  if (enabled) {
+    if (scroll.documentView != text) scroll.documentView = text;
+    if (scroll.superview != container) [container addSubview:scroll];
+  } else {
+    if (scroll.documentView == text) scroll.documentView = nil;
+    [scroll removeFromSuperview];
+    if (text.superview != container) [container addSubview:text];
+  }
+}
+#endif
