+template <typename MarkdownStyleProps>
+BOOL ENRMApplyInputMarkdownBlockStyle(ENRMInputFormatterStyle *style, const MarkdownStyleProps &markdownStyle,
+                                     NSString *markdown, BOOL *usesParagraphBaselineOffset)
+{
+  NSString *trimmedMarkdown = [markdown stringByTrimmingCharactersInSet:NSCharacterSet.whitespaceAndNewlineCharacterSet];
+  BOOL changed = NO;
+  *usesParagraphBaselineOffset = YES;
+
+  if ([trimmedMarkdown hasPrefix:@"```"] || [trimmedMarkdown hasPrefix:@"~~~"]) {
+    *usesParagraphBaselineOffset = NO;
+    changed = applyInputBlockStyleProps(style, markdownStyle.codeBlock);
+  } else {
