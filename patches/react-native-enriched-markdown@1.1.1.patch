+- (void)drawInRect:(CGRect)rect atPoint:(CGPoint)origin;
+@end
+#endif
diff --git a/ios/utils/ENRMCodeBlockLineLayout.m b/ios/utils/ENRMCodeBlockLineLayout.m
new file mode 100755
index 00000000..f185deba
--- /dev/null
+++ b/ios/utils/ENRMCodeBlockLineLayout.m
@@ -0,0 +1,96 @@
+#import "ENRMCodeBlockLineLayout.h"
+#if TARGET_OS_OSX
+
+@implementation ENRMCodeBlockLineLayout {
+  NSArray<NSAttributedString *> *_lines;
+  NSArray<NSNumber *> *_lineOffsets;
+  CGSize _size;
+}
+
+static void enumerateCodeLines(NSString *text, void (^visit)(NSRange range))
+{
+  NSUInteger position = 0;
+  while (position < text.length) {
+    NSUInteger end, contentsEnd;
+    [text getLineStart:NULL end:&end contentsEnd:&contentsEnd forRange:NSMakeRange(position, 0)];
+    visit(NSMakeRange(position, contentsEnd - position));
+    position = end;
+    if (end == text.length && contentsEnd < end) visit(NSMakeRange(end, 0));
+  }
+}
+
+- (instancetype)initWithAttributedCode:(NSAttributedString *)code
+{
+  if ((self = [super init])) {
+    NSMutableArray<NSAttributedString *> *lines = [NSMutableArray new];
+    NSMutableArray<NSNumber *> *offsets = [NSMutableArray new];
+    __block CGFloat width = 0;
+    __block CGFloat height = 0;
+    enumerateCodeLines(code.string, ^(NSRange range) {
+      NSAttributedString *line;
+      if (range.length > 0) {
+        line = [code attributedSubstringFromRange:range];
+      } else {
+        // An empty line still consumes the configured line height.
+        NSDictionary *attributes = [code attributesAtIndex:MIN(range.location, code.length - 1) effectiveRange:NULL];
+        line = [[NSAttributedString alloc] initWithString:@" " attributes:attributes];
+      }
+      CGRect bounds = [line boundingRectWithSize:CGSizeMake(CGFLOAT_MAX, CGFLOAT_MAX)
+                                        options:NSStringDrawingUsesLineFragmentOrigin context:nil];
+      [offsets addObject:@(height)];
+      [lines addObject:line];
+      height += bounds.size.height;
+      if (range.length > 0) width = MAX(width, bounds.size.width);
+    });
+    _lines = lines;
+    _lineOffsets = offsets;
+    _size = CGSizeMake(ceil(width), ceil(height));
+  }
+  return self;
+}
+
+- (CGSize)size { return _size; }
+
++ (CGFloat)heightForAttributedCode:(NSAttributedString *)code
+{
+  if (code.length == 0) return 0;
+  // Code block styling sets one font and paragraph style for the whole block.
+  // With fixed line height, shadow measurement needs no glyph shaping at all.
+  NSParagraphStyle *style = [code attribute:NSParagraphStyleAttributeName atIndex:0 effectiveRange:NULL];
+  if (style.minimumLineHeight > 0 && style.maximumLineHeight == style.minimumLineHeight) {
+    __block NSUInteger count = 0;
+    enumerateCodeLines(code.string, ^(__unused NSRange range) { count++; });
+    return ceil(count * style.minimumLineHeight);
+  }
+  return [[self alloc] initWithAttributedCode:code].size.height;
+}
+
+- (NSRange)lineRangeIntersectingRect:(CGRect)rect
+{
+  if (_lines.count == 0 || CGRectGetMaxY(rect) <= 0 || CGRectGetMinY(rect) >= _size.height) {
+    return NSMakeRange(0, 0);
+  }
+  NSUInteger low = 0, high = _lines.count;
+  while (low < high) {
+    NSUInteger middle = low + (high - low) / 2;
+    CGFloat bottom = middle + 1 < _lines.count ? _lineOffsets[middle + 1].doubleValue : _size.height;
+    if (bottom <= CGRectGetMinY(rect)) low = middle + 1; else high = middle;
+  }
+  NSUInteger start = low;
+  while (low < _lines.count && _lineOffsets[low].doubleValue < CGRectGetMaxY(rect)) low++;
+  return NSMakeRange(start, low - start);
+}
+
+- (void)drawInRect:(CGRect)rect atPoint:(CGPoint)origin
+{
+  // Include one line of glyph overhang beyond the dirty rectangle.
+  NSRange range = [self lineRangeIntersectingRect:CGRectOffset(rect, -origin.x, -origin.y)];
+  if (range.length == 0) return;
+  NSUInteger start = range.location > 0 ? range.location - 1 : 0;
+  NSUInteger end = MIN(NSMaxRange(range) + 1, _lines.count);
+  for (NSUInteger index = start; index < end; index++) {
+    [_lines[index] drawAtPoint:CGPointMake(origin.x, origin.y + _lineOffsets[index].doubleValue)];
+  }
+}
+@end
+#endif
