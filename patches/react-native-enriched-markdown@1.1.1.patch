@@ -0,0 +1,26 @@
+#pragma once
+#import "ENRMInputParser.h"
+#import "ENRMInputFormatter.h"
+#import "ENRMInputMeasurementStyle.h"
+#import "InputStylePropsUtils.h"
+#import "ENRMInputMeasurement.h"
+
+template <typename InputProps>
+static NSAttributedString *ENRMInitialInputMeasurementText(const InputProps &props, NSWritingDirection direction)
+{
+  ENRMInputFormatterStyle *style = [[ENRMInputFormatterStyle alloc] init];
+  applyInputStyleProps(style, props, InputProps{});
+  NSString *markdown = [NSString stringWithUTF8String:props.defaultValue.c_str()];
+  BOOL usesBaseline = YES;
+  ENRMApplyInputMarkdownBlockStyle(style, props.markdownStyle, markdown, &usesBaseline);
+  ENRMParseResult *parsed = [[[ENRMInputParser alloc] init] parseToPlainTextAndRanges:markdown];
+  NSTextStorage *storage = [[NSTextStorage alloc] initWithString:parsed.plainText];
+  ENRMInputFormatter *formatter = [[ENRMInputFormatter alloc] init];
+  NSRange range = NSMakeRange(0, storage.length);
+  [formatter applyFormattingRanges:parsed.formattingRanges toTextStorage:storage style:style scopedToRange:range];
+  [formatter applyBlockRanges:parsed.blockRanges toTextStorage:storage style:style scopedToRange:range];
+  ENRMWritingDirectionMode mode = ENRMResolveWritingDirectionMode([NSString stringWithUTF8String:props.writingDirection.c_str()]);
+  ENRMApplyWritingDirectionMode(storage, mode, direction);
+  ENRMApplyInputParagraphBaselineOffset(storage, usesBaseline);
+  return ENRMPrepareInputMeasurementText(storage, ENRMInputBaseTypingAttributes(style));
+}
