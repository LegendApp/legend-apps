+#if TARGET_OS_OSX
+NSString *_Nullable extractMarkdownFromHTML(NSData *data)
+{
+  NSAttributedString *rich = [[NSAttributedString alloc] initWithData:data
+      options:@{NSDocumentTypeDocumentAttribute: NSHTMLTextDocumentType}
+      documentAttributes:nil error:nil];
+  if (rich == nil) return nil;
+  // AppKit appends a paragraph terminator to an HTML fragment.
+  NSUInteger length = rich.length;
+  if (length > 0 && [rich.string characterAtIndex:length - 1] == '\n') length--;
+  NSString *markdown = extractMarkdownFromAttributedString(rich, NSMakeRange(0, length));
+  NSString *html = [[NSString alloc] initWithData:data encoding:NSUTF8StringEncoding];
+  NSUInteger end = html.length;
+  while (end > 0 && ([html characterAtIndex:end - 1] == ' ' || [html characterAtIndex:end - 1] == '\t')) end--;
+  NSString *suffix = [html substringFromIndex:end];
+  return suffix.length > 0 && ![markdown hasSuffix:suffix] ? [markdown stringByAppendingString:suffix] : markdown;
+}
+#endif
