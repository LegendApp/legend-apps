--- /dev/null
+++ b/vendor/node_modules/@legendapp/spark-cli/dist/runtime-input-cache.js
@@ -0,0 +1,109 @@
+import { realpathSync, statSync, watch } from "node:fs";
+import path from "node:path";
+import { createRequire } from "node:module";
+import { installedPackages, nativePackages } from "./project.js";
+import { isExpoProject } from "@legendapp/spark-desktop-config/config.cjs";
+
+/** Native compatibility inputs are stable until a source or resolution path changes. */
+export function createRuntimeInputCache(root) {
+    let value;
+    let dirty = true;
+    let disabled = false;
+    let watchers = [];
+    let resolutionPaths = new Map();
+    let observedRoots = "";
+    let readiness;
+    const identity = location => {
+        try {
+            const stat = statSync(location, { throwIfNoEntry: false });
+            return stat ? `${stat.dev}:${stat.ino}` : null;
+        } catch (error) {
+            if (error.code === "ENOTDIR") return null;
+            throw error;
+        }
+    };
+    const stop = () => {
+        clearImmediate(readiness); readiness = undefined;
+        for (const watcher of watchers) watcher.close();
+        watchers = [];
+    };
+    const invalidate = () => { dirty = true; };
+    const fail = () => { disabled = true; dirty = true; stop(); };
+    const calculate = () => ({ native: nativePackages(root) });
+    function observe(installed) {
+        const realRoot = realpathSync(root);
+        const requested = new Map();
+        const add = (location, recursive) => {
+            const directory = realpathSync(location);
+            requested.set(directory, recursive || requested.get(directory) || false);
+        };
+        const paths = new Map();
+        add(root, true);
+        add(path.dirname(root), false);
+        for (const directory of [root, ...installed.map(pkg => pkg.root)]) {
+            add(directory, true);
+            add(path.dirname(directory), false);
+            for (const search of createRequire(path.join(directory, "package.json")).resolve.paths("__spark_runtime_inputs__") ?? []) {
+                if (!paths.has(search)) {
+                    const current = identity(search);
+                    paths.set(search, current);
+                    if (current !== null) add(search, true);
+                }
+            }
+        }
+        const recursiveRoots = [...requested].filter(([, recursive]) => recursive).map(([directory]) => directory);
+        const roots = [...requested].filter(([directory]) => !recursiveRoots.some(parent => parent !== directory && directory.startsWith(parent + path.sep)));
+        const key = JSON.stringify(roots.map(([directory, recursive]) => [directory, recursive, identity(directory)]));
+        if (key === observedRoots) { resolutionPaths = paths; return; }
+        const next = [];
+        try {
+            for (const [directory, recursive] of roots) {
+                const watcher = watch(directory, { recursive }, (_event, filename) => {
+                    const relative = filename === null ? null : path.relative(realRoot, path.join(directory, String(filename))).split(path.sep).join("/");
+                    // Session status is output of the check, never an input to it.
+                    if (relative && /^\.spark\/(?:platforms\/[^/]+\/)?session\.json(?:\.\d+\.tmp)?$/.test(relative)) return;
+                    invalidate();
+                });
+                watcher.on("error", fail);
+                next.push(watcher);
+            }
+        } catch {
+            for (const watcher of next) watcher.close();
+            fail();
+            return;
+        }
+        stop();
+        watchers = next;
+        resolutionPaths = paths;
+        observedRoots = key;
+        // A watch may start asynchronously. Recheck once after its first event-loop turn.
+        readiness = setImmediate(() => { readiness = undefined; invalidate(); });
+    }
+    return {
+        invalidate,
+        read() {
+            // Expo config can depend on arbitrary external modules or environment.
+            if (disabled || isExpoProject(root)) return calculate();
+            if (!dirty) {
+                try {
+                    for (const [location, previous] of resolutionPaths) if (identity(location) !== previous) { dirty = true; break; }
+                } catch { fail(); return calculate(); }
+                if (!dirty) return value;
+            }
+            dirty = false;
+            try {
+                const installed = installedPackages(root);
+                try { observe(installed); } catch { fail(); }
+                value = calculate();
+                // Sources were watched before calculation. A concurrent graph change
+                // must also receive a fresh set of source watches on the next poll.
+                if (JSON.stringify(installed) !== JSON.stringify(installedPackages(root))) dirty = true;
+                return value;
+            } catch (error) {
+                dirty = true;
+                throw error;
+            }
+        },
+        close() { disabled = true; stop(); },
+    };
+}
