  "name": "legend-apps",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "enriched-markdown": {
    "enableCodeHighlight": true,
    "enableMath": true
  },
  "workspaces": [
    "shell",
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "react-native-enriched-markdown",
    "@legendapp/spark"
  ],
  "scripts": {
    "spark": "bun scripts/spark-app.ts",
    "spark:warm": "bun scripts/spark-warm.ts",
