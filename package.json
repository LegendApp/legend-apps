    "profile:markdown-e2e": "bun scripts/profile-markdown-e2e.ts",
    "test:markdown-e2e:code-block-smoke": "MARKDOWN_E2E_SCENARIO=editor-code-block-smoke bun scripts/test-markdown-e2e.ts",
    "test:markdown-e2e:edit-navigation-smoke": "MARKDOWN_E2E_SCENARIO=editor-edit-navigation-smoke bun scripts/test-markdown-e2e.ts",
    "test:markdown-e2e:navigation-smoke": "MARKDOWN_E2E_SCENARIO=editor-navigation-smoke bun scripts/test-markdown-e2e.ts",
    "test:markdown-e2e:selection-smoke": "MARKDOWN_E2E_SCENARIO=editor-selection-smoke bun scripts/test-markdown-e2e.ts",
    "test:markdown-e2e:soft-wrap-selection": "MARKDOWN_E2E_SCENARIO=editor-soft-wrap-selection bun scripts/test-markdown-e2e.ts",
    "test:markdown-e2e:theme-reflow-smoke": "MARKDOWN_E2E_SCENARIO=editor-theme-reflow-smoke bun scripts/test-markdown-e2e.ts",
    "test:markdown-e2e:ui-smoke": "MARKDOWN_E2E_SCENARIO=editor-ui-smoke bun scripts/test-markdown-e2e.ts",
    "test:markdown-editing": "bun run test:markdown-parser && bun run test:markdown-document && bun run test:markdown-toolbar",
    "test:markdown-editing:all": "bun run test:markdown-regression && bun run test:markdown-e2e && bun run test:markdown-e2e:ui-smoke && bun run test:markdown-e2e:selection-smoke && bun run test:markdown-e2e:soft-wrap-selection && bun run test:markdown-e2e:code-block-smoke && bun run test:markdown-e2e:navigation-smoke && bun run test:markdown-e2e:edit-navigation-smoke && bun run test:markdown-e2e:theme-reflow-smoke && bun run test:markdown-e2e:large-document",
