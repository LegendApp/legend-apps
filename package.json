    "test:chat-history:native": "bash packages/chat-history/tests/run-native.sh",
    "test:chat-history:recent": "bash packages/chat-history/tests/run-native.sh --audit-recent",
    "test:changelog": "node --test scripts/lib/changelogScope.test.ts scripts/lib/releasePublishing.test.ts",
    "test:markdown-toolbar": "jest --config apps/markdown/jest.config.cjs",
    "typecheck": "tsc --noEmit",
    "verify:react-compiler": "bun scripts/verify-react-compiler.ts",
    "test:markdown-app": "jest --config apps/markdown/jest.config.cjs",
    "test:markdown-native": "bash packages/markdown-block-editor/tests/run-native.sh",
    "test:markdown-regression": "bun run test:markdown-editing && bun run test:markdown-native && bun run test:legend-list && bun run typecheck && bun markdown verify macos",
    "test:markdown-e2e:large-document": "MARKDOWN_E2E_SCENARIO=editor-large-document bun scripts/test-markdown-e2e.ts",
    "photos": "bun scripts/run-app.ts photos",
    "test:photos": "bun test --isolate apps/photos/tests",
    "test:workspace": "jest --config packages/workspace/jest.config.cjs",
    "postinstall": "node scripts/prepare-spark-install.cjs"
