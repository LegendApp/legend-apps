{
  "$schema": "https://legend.so/git/git-settings.v1.schema.json",
  "version": 1,
  "name": "Fork",
  "description": "Fork's organization: the commit list down the left with details, files and diff to its right; unstaged over staged with the composer below; compact rows, thin ring lanes, icon-only toolbar, branches first in the sidebar.",
  "extends": "sourcetree",
  "density": "compact",
  "layout": {
    "active": "fork",
    "layouts": {
      "fork": {
        "sidebar": {
          "width": 200
        },
        "views": {
          "default": {
            "type": "split",
            "direction": "row",
            "children": [
              {
                "node": {
                  "type": "panel",
                  "panel": "commitList"
                },
                "size": 520,
                "minSize": 360
              },
              {
                "node": {
                  "type": "split",
                  "direction": "column",
                  "children": [
                    {
                      "node": {
                        "type": "panel",
                        "panel": "commitDetails"
                      },
                      "size": 110
                    },
                    {
                      "node": {
                        "type": "panel",
                        "panel": "fileList"
                      },
                      "size": 170,
                      "minSize": 100
                    },
                    {
                      "node": {
                        "type": "panel",
                        "panel": "diff"
                      },
                      "minSize": 200
                    }
                  ]
                },
                "minSize": 360
              }
            ]
          },
          "changes": {
            "type": "split",
            "direction": "row",
            "children": [
              {
                "node": {
                  "type": "split",
                  "direction": "column",
                  "children": [
                    {
                      "node": {
                        "type": "panel",
                        "panel": "unstaged"
                      }
                    },
                    {
                      "node": {
                        "type": "panel",
                        "panel": "staged"
                      }
                    },
                    {
                      "node": {
                        "type": "panel",
                        "panel": "composer"
                      },
                      "size": 180,
                      "minSize": 104
                    }
                  ]
                },
                "size": 320,
                "minSize": 260
              },
              {
                "node": {
                  "type": "panel",
                  "panel": "diff"
                },
                "minSize": 400
              }
            ]
          }
        }
      }
    }
  },
  "panels": {
    "commitList": {
      "columns": [
        {
          "id": "graph",
          "width": 70
        },
        {
          "id": "subject"
        },
        {
          "id": "author",
          "width": 110
        },
        {
          "id": "date",
          "width": 90
        }
      ],
      "graph": {
        "style": "compact",
        "laneWidth": 10,
        "lineWidth": 1.5,
        "nodeStyle": "ring",
        "colorBy": "branch"
      },
      "refs": "inline",
      "dateFormat": "relative"
    },
    "unstaged": {
      "style": "flat",
      "stagingControl": "buttons"
    },
    "staged": {
      "style": "flat",
      "stagingControl": "buttons"
    },
    "fileList": {
      "style": "flat"
    },
    "diff": {
      "mode": "unified",
      "contextLines": 3
    }
  },
  "sidebar": {
    "sections": [
      {
        "id": "workspace"
      },
      {
        "id": "branches"
      },
      {
        "id": "remotes"
      },
      {
        "id": "tags",
        "expanded": false
      },
      {
        "id": "stashes"
      },
      {
        "id": "worktrees"
      },
      {
        "id": "pullRequests"
      },
      {
        "id": "reviewQueue",
        "expanded": false
      }
    ]
  },
  "toolbar": {
    "displayMode": "iconOnly",
    "items": [
      "fetch",
      "pull",
      "push",
      "space",
      "stash-changes",
      "pop-stash",
      "space",
      "new-branch",
      "merge-ref",
      "rebase-ref",
      "flexibleSpace",
      "networkProgress",
      "branchPicker",
      "search"
    ]
  }
}
