{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022"
  },
  "include": [
    "apps",
    "packages",
    "scripts",
    "shell"
  ],
  "exclude": [
    "packages/*/vendor",
    "shell/ios",
    "shell/android",
    "shell/macos/Pods"
  ]
}
